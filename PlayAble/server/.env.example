# PlayAble Server Environment Variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MONGODB_URI=mongodb://localhost:27017/playabledb
PORT=5001

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Application Environment (development, production, test)
# Controls security header strictness and logging verbosity
NODE_ENV=development

# Allowed Origins for CORS (comma-separated list)
# Example: http://localhost:5173,http://localhost:3000,https://playable.com
ALLOWED_ORIGINS=http://localhost:5173

# Content Security Policy (CSP) Configuration
# CSP Violation Report URI (optional - for production monitoring)
CSP_REPORT_URI=/api/csp-violation-report

# CSP Report Only Mode (true/false)
# When true, violations are reported but not blocked (useful for testing)
CSP_REPORT_ONLY=false

# ============================================================================
# JWT CONFIGURATION (For future implementation)
# ============================================================================
# JWT_ACCESS_SECRET=your-256-bit-secret-key-here
# JWT_REFRESH_SECRET=your-different-256-bit-secret-key-here
# JWT_ACCESS_EXPIRY=15m
# JWT_REFRESH_EXPIRY=7d
# JWT_ISSUER=playable-api
# JWT_AUDIENCE=playable-client

# ============================================================================
# RATE LIMITING CONFIGURATION (For future implementation)
# ============================================================================
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# CSRF PROTECTION
# ============================================================================
# CSRF Secret for token generation (REQUIRED - change in production)
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CSRF_SECRET=your-csrf-secret-change-this-in-production

# Cookie Secret for signing cookies (REQUIRED - change in production)
COOKIE_SECRET=your-cookie-secret-change-this-in-production

# Development bypass (DO NOT enable in production)
# When true, allows requests without CSRF tokens in development
CSRF_DEV_BYPASS=false

# ============================================================================
# EMAIL CONFIGURATION (If using email services)
# ============================================================================
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USER=noreply@playable.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM=PlayAble <noreply@playable.com>

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
# LOG_LEVEL=info
# ENABLE_SECURITY_LOGGING=true

# ============================================================================
# PRODUCTION DEPLOYMENT
# ============================================================================
# For production deployment, ensure:
# 1. NODE_ENV=production
# 2. Use strong, random secrets for JWT and CSRF
# 3. Configure ALLOWED_ORIGINS to match your frontend domain(s)
# 4. Set up proper MongoDB connection string with authentication
# 5. Enable HTTPS (security headers will enforce this)
# 6. Configure CSP_REPORT_URI to monitor violations
